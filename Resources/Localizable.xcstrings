      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder で表示"
          }
        }
      }
    },
    "Since %@" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ から"
          }
        }
      }
    },
    "Starting Server…" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバを起動しています…"
          }
        }
      }
    },
    "Stop Server" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止"
          }
        }
      }
    },
    "Stop Server…" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバを停止…"
          }
        }
      }
    },
    "Stop a server Paddock did not start?" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paddock が起動していないサーバを停止しますか？"
          }
        }
      }
    },
    "Stopping Server…" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバを停止しています…"
          }
        }
      }
    },
    "The running server was started outside Paddock, so its output is not recorded. This is the last server Paddock started." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動いているサーバは Paddock 以外で起動されたため，出力は記録されていません．これは Paddock が最後に起動したサーバのログです．"
          }
        }
      }
    },
    "The server stopped unexpectedly. The log has the details." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバが予期せず止まりました．詳しくはログを見てください．"
          }
        }
      }
    },
    "The server stopped while starting. The log has the details." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバが起動の途中で止まりました．詳しくはログを見てください．"
          }
        }
      }
    },
    "The server was not listening after %lld seconds, so Paddock stopped it." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 秒たっても待ち受けを始めなかったため，サーバを停止しました．"
          }
        }
      }
    },
    "This server (pid %@) was started outside Paddock, for example from Terminal. Apps using it lose their connection." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサーバ（pid %@）はターミナルなど Paddock 以外から起動されました．使用中のアプリは接続が切れます．"
          }
        }
      }
    },
    "Turn Off Server" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバを OFF にする"
          }
        }
      }
    },
    "Turn On Server" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバを ON にする"
          }
        }
      }
    },
    "Turn On Server When Paddock Opens" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paddock を開いたときにサーバを ON にする"
          }
        }
      }
    },
    "Unload Immediately" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すぐに解放"
          }
        }
      }
    },
    "Used from the next server start. Apps can override it for each request." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次回のサーバ起動から有効．アプリは要求ごとに上書きできます．"
          }
        }
      }
    },
    "ollama Is Not Installed" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ollama が入っていません"
          }
        }
      }
    },
    "ollama could not be started: %@" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ollama を起動できませんでした: %@"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
